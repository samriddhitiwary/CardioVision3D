# ==============================================================================
# CardioVision3D Environment Configuration
# ==============================================================================
# Copy this file to '.env' at the repository root before starting the services:
#   cp .env.example .env

# ------------------------------------------------------------------------------
# Backend Server Configuration
# ------------------------------------------------------------------------------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# Allowed frontend origins for CORS (JSON array formatted string)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ------------------------------------------------------------------------------
# Frontend Vite Configuration
# ------------------------------------------------------------------------------
# API base URL consumed by Vite frontend client
VITE_API_BASE_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# Database Connection (PostgreSQL / Supabase)
# ------------------------------------------------------------------------------
# Option A: Supabase Cloud PostgreSQL
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# Option B: Local PostgreSQL instance
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# ------------------------------------------------------------------------------
# JWT Authentication & Security
# ------------------------------------------------------------------------------
# Generate a cryptographically secure key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_to_a_secure_random_secret_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------------------------
# Supabase Storage & Service Credentials
# ------------------------------------------------------------------------------
# Required for PDF Clinical Report generation and storage.
# Note: Ensure a public bucket named 'patient-reports' is created in your Supabase project.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# ------------------------------------------------------------------------------
# AI Risk Story & Gemini Generative Narrative
# ------------------------------------------------------------------------------
# Google AI Studio API key (get one from https://aistudio.google.com/)
# If omitted or invalid, the system automatically falls back to deterministic clinical templates.
GEMINI_API_KEY=your_gemini_api_key_here

# Generative model chain with automatic fallback
RISK_STORY_MODEL=gemini-3.8-flash
RISK_STORY_FALLBACK_MODELS=gemini-3.5-flash
RISK_STORY_THINKING_LEVEL=low
RISK_STORY_MAX_OUTPUT_TOKENS=1200
RISK_STORY_TIMEOUT_SECONDS=20
RISK_STORY_MAX_FACTORS=6
RISK_STORY_CACHE_ENABLED=true

